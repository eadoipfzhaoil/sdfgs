# Railway خودش DATABASE_URL را از سرویس PostgreSQL می‌دهد (Reference Variable)
DATABASE_URL=
SECRET_KEY=یک-رشته-طولانی-و-تصادفی
# هر کسی با این ایمیل‌ها ثبت‌نام کند ادمین می‌شود (با کاما جدا کنید)
ADMIN_EMAILS=you@example.com

# هوش مصنوعی (هر API سازگار با OpenAI)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
IMAGE_MODEL=gpt-image-1

# ویدیو (Replicate)
REPLICATE_API_TOKEN=
VIDEO_MODEL=minimax/video-01

# مقدار اولیه کارت (بعداً از پنل ادمین قابل تغییر است)
CARD_NUMBER=6037-0000-0000-0000
CARD_HOLDER=نام صاحب کارت
CURRENCY=تومان
